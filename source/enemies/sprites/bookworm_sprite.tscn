[sub_resource type="GDScript" id="GDScript_4p476"]
script/source = "extends Sprite2D


func _ready():
	update_spots(frame)


func _set(property: StringName, value: Variant) -> bool:
	if String(property) == \"frame\":
		update_spots(value)

	return false


func update_spots(value):
	var i = 0

	for spot in [$SpotA, $SpotB, $SpotC]:
		var frame_offset = hframes * i
		spot.frame = value + frame_offset

		i += 1
"
RefCounted = null
Resource = null
Script = null
FakeScript = null

