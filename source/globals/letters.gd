static func get_face_value(faces: Variant, wildcard_faces: Dictionary[int, String] = {}) -> int:
 var check_faces: Array[String]
 if faces is String:
  check_faces = [faces]
 else:
  check_faces.assign(faces)

 var value: = 0
 var face_index: = 0

