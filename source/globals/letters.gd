static func string_array_or_null(source: Variant) -> Variant:
 if source is Array:
  return source
 elif source is String:
  return [source]

 return null


static func shift_character(character: String, character_lists: Array[Array], offset: int = 0, loop: bool = true, remap_lists: Array[Array] = []) -> String:
 var sub_list_index: = 0
 var character_index: = -1
 for sub_list: Array in character_lists:
  var index_in_sub_list: = sub_list.find(character)
  if index_in_sub_list != -1:
   character_index = index_in_sub_list
   break

  sub_list_index += 1

 if character_index == -1:
  return character

 var list_size: int = character_lists[sub_list_index].size()
 var new_index: = character_index + offset
 if new_index < 0 or new_index >= list_size:
  if loop:
   new_index = (character_index + offset) % list_size
  else:
   new_index = character_index - offset

 if not remap_lists.is_empty():
  return remap_lists[sub_list_index][new_index]

 return character_lists[sub_list_index][new_index]


static func shift_face(face: String, character_lists: Array[Array], offset: int = 0, loop: bool = true, remap_lists: Array[Array] = []) -> String:
 var new_face: = ""
 for character in face:
  new_face += shift_character(character, character_lists, offset, loop, remap_lists)

 return new_face


static func shift_faces(faces: Array[String], character_lists: Array[Array], offset: int = 0, loop: bool = true, remap_lists: Array[Array] = []) -> Array[String]:
 var new_faces: Array[String] = []
 for face in faces:
  new_faces.append(shift_face(face, character_lists, offset, loop, remap_lists))

 return new_faces


static func has_any_substring(string: String, substrings: Array):
 return substrings.any( func(substring: String): return substring in string)


static func face_matches_string(face: String, string: String) -> bool:
 var face_length: = len(face)
 if face_length != len(string):
  return false

 var suits: Dictionary[String, String] = {}
 for i in face_length:
  var character: = face[i]
  if character == "*":
   continue
  elif character in SUITS:
   if character not in suits:
    suits[character] = string[i]
   elif suits[character] != string[i]:
    return false
  elif character in NUMPAD_CHARACTERS:
   if string[i] not in NUMPAD_CHARACTERS[character]:
    return false
  elif character != string[i]:
   return false

 return true


static func get_face_weight_in_list(face: String, list: Dictionary[String, float]) -> float:
 var sorted_list: = list.keys()
 sorted_list.reverse()
 for string in sorted_list:
  if face_matches_string(face, string):
   return list[string]

 return -1.0
