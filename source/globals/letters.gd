static func filter_pool(pool: Dictionary[String, float], params: Dictionary) -> Dictionary[String, float]:
 var default_params: = {
  include_letters = null, 
  exclude_letters = null, 
  must_have_consonant = false, 
  must_have_vowel = false, 
  min_weight = 0.0, 
  max_weight = INF, 



  backup_cutoff = null, 
 }

 params.merge(default_params)

 var backup_keys: = PackedStringArray()
 var filtered: Dictionary[String, float] = {}

 for key: String in pool:
  if params.include_letters != null and not has_any_substring(key, params.include_letters):
   continue

  if params.exclude_letters != null and has_any_substring(key, params.exclude_letters):
   continue

  if params.must_have_consonant and not has_any_substring(key, CONSONANTS):
   continue

  if params.must_have_vowel and not has_any_substring(key, VOWELS):
   continue

  backup_keys.append(key)

  if pool[key] < params.min_weight or pool[key] > params.max_weight:
   continue

  filtered[key] = pool[key]

 if filtered.is_empty() and not backup_keys.is_empty():
  if params.backup_cutoff != null:
   var backup_size: = backup_keys.size()
   var backup_cutoff_index: int = backup_size - ceili(backup_size * params.backup_cutoff)
   backup_keys = backup_keys.slice(backup_cutoff_index)

   for key: String in backup_keys:
    filtered[key] = pool[key]

  return {backup_keys[-1]: pool[backup_keys[-1]]}

 return filtered


static func pick_from_pool(pool: Dictionary[String, float], rng: RNG = Game.random, params: Dictionary = {}) -> String:
 var include_letter: String = ""
 var original_letter: String = ""
 if "include_letters" in params and params.include_letters != null and params.include_letters.size() == 1:
  original_letter = params.include_letters[0]
  include_letter = original_letter
  if original_letter == "*":
   include_letter = get_random_letter(null, rng)
   params.include_letters = [include_letter]
  elif original_letter in NUMPAD_CHARACTERS:
   include_letter = rng.pick_random(NUMPAD_CHARACTERS[original_letter])
   params.include_letters = [include_letter]

 var filtered: = filter_pool(pool, params)
 var result: String = rng.weighted_random(filtered)

 if include_letter != original_letter:
  var location_in_result = result.find(include_letter)
  result = result.erase(location_in_result)
  result = result.insert(location_in_result, original_letter)

 return result


