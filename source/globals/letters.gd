static func get_adjusted_letters(include = LETTERS, exclude = [], letter_census = null):
 if is_same(include, LETTERS) and letter_census == null and exclude.is_empty():
  return LETTERS

 if exclude is not Array and exclude is not PackedStringArray:
  exclude = [exclude]

 for exclude_letter in exclude.duplicate():
  if exclude_letter in NUMPAD_CHARACTERS:
   exclude.append_array(NUMPAD_CHARACTERS[exclude_letter])

 var letters = {}
 var lenience = 0

 if Game.player.id == Globals.CHARACTERS.CHILD:
  lenience = 2

 for letter in include:
  if letter in exclude:
   continue

  if letter_census == null or letter not in letter_census:
   letters[letter] = LETTERS[letter]
   continue

  var letter_amount = letter_census[letter]

  if letter_amount >= LETTER_CAPS[letter].hard + lenience:
   letters[letter] = LETTERS[letter] * 0.1
  elif letter_amount >= LETTER_CAPS[letter].soft + lenience:
   letters[letter] = LETTERS[letter] * 0.5
  else:
   letters[letter] = LETTERS[letter]


 if letters.is_empty():
  return get_adjusted_letters(include, exclude)

 return letters




